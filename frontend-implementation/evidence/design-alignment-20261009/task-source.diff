+
+/* October 5 workspace hierarchy, reconciled with the accepted layout options. */
+.sidebar-tab-trigger { align-self: center; flex: 0 0 auto; margin-inline-start: 8px; font-size: 13px; min-height: 32px; }
+.document-tabs { min-height: 44px; align-items: stretch; }
+.tab.active > button[role="tab"] { font-weight: 600; }
+.tab { max-width: 220px; }
+.tab-strip { scrollbar-width: thin; }
+.document-list-trigger { align-self: center; min-height: 32px; margin: 6px 12px 6px 4px; border-radius: 6px; }
+.sidebar-footnote > button { border-color: transparent; padding: 3px 0; background: transparent; }
+.document-actions-disclosure { flex: 0 0 auto; }
+.document-actions-body { position: fixed; z-index: 40; display: flex; flex-direction: column; flex-wrap: nowrap;
+  width: min(360px, calc(100vw - 32px)); padding: 6px; overflow: auto; overscroll-behavior: contain;
+  background: var(--surface); border: 1px solid var(--control-border); border-radius: 6px; box-shadow: 0 8px 24px var(--shadow); }
+.document-actions-body > button, .document-actions-body .path-disclosure > summary { width: 100%; text-align: start; border-color: transparent; background: transparent; min-height: 32px; }
+.document-actions-body > button:hover, .document-actions-body .path-disclosure > summary:hover { background: var(--hover); }
+.document-actions-body .path-disclosure { width: 100%; }
+.document-actions-body .path-disclosure div { line-height: 1.5; }
+.folder-search-groups { flex: 1 1 auto; min-width: 0; overflow-x: hidden; }
+.folder-search-groups > section { min-width: 0; }
