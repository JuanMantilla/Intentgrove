--- before/src/styles/app.css
+++ src/styles/app.css
@@ -1042,5 +1042,34 @@
 .preview-loading-dots > i { display: block; width: 6px; height: 6px; border-radius: 50%; background: currentColor; animation: preview-loading-pulse 1.2s ease-in-out infinite; }
 .preview-loading-dots > i:nth-child(2) { animation-delay: .15s; }
 .preview-loading-dots > i:nth-child(3) { animation-delay: .3s; }
-@keyframes preview-loading-pulse { 0%, 80%, 100% { opacity: .3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-4px); } }
+@keyframes preview-loading-pulse { 0%, 80%, 100% { opacity: .3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-3px); } }
 @media (prefers-reduced-motion: reduce) { .preview-loading-dots > i { animation: none; opacity: .7; } }
+
+/* Approved loading system: one local indicator; motion never encodes progress. */
+.preview-loading { gap: 8px; }
+.preview-loading .loading-label, .loading-detail { color: var(--text); font-size: 13px; }
+.preview-loading-progress, .preview-loading-placeholder { flex-direction: column; align-items: stretch; min-height: 0; padding: 12px 0; }
+.loading-track { display: block; overflow: hidden; height: 3px; min-width: 80px; width: 100%; background: var(--border); border-radius: 4px; }
+.loading-track > i { display: block; height: 100%; background: var(--accent); }
+.loading-track[data-measured="false"] > i { width: 24%; animation: loading-travel 2s ease-in-out infinite; }
+@keyframes loading-travel { from { transform: translateX(-110%); } to { transform: translateX(430%); } }
+.loading-rows { display: grid; gap: 18px; width: 100%; }
+.loading-rows > i { height: 16px; border-radius: 4px; background: var(--border); animation: loading-breathe 1.7s ease-in-out infinite; }
+@keyframes loading-breathe { 50% { opacity: .4; } }
+.preview-loading[data-motion="off"] i { animation-play-state: paused; }
+button:has(.preview-loading):disabled { opacity: 1; }
+button .preview-loading { color: inherit; }
+.tab-refresh-status .preview-loading { padding: 0; }
+.section-edit-button:has(.preview-loading) { opacity: 1; }
+.reload-progress .preview-loading-progress { min-width: 120px; padding: 0; }
+@media (prefers-reduced-motion: reduce) {
+  .preview-loading i { animation: none !important; transform: none !important; opacity: .7; }
+  .loading-track[data-measured="false"] > i { width: 100%; background: var(--border); }
+}
+
+.document-acquisition { display: flex; align-items: center; gap: 12px; padding: 10px 20px; font-size: 13px; min-width: 0; }
+.document-acquisition > span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+[hidden] .preview-loading i, [inert] .preview-loading i, [aria-hidden="true"] .preview-loading i { animation-play-state: paused; }
+.tab-refresh-status:has(.preview-loading) { position: absolute; right: 8px; top: 5px; pointer-events: none; }
+.tab-strip [role="tab"] { position: relative; }
