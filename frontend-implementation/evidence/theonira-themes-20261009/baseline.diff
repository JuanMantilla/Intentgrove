+/// Type-aware filename opening, preserving search job/root/scope ownership.
+#[tauri::command]
+pub async fn open_local_search_hit(
+    window: tauri::WebviewWindow,
+    state: tauri::State<'_, AppState>,
+    searches: tauri::State<'_, SearchState>,
+    job_id: String,
+    hit_id: String,
+) -> AppResult<crate::html::LocalView> {
+    if window.label() != "main" {
+        return Err(AppError::new("html_denied", "Workspace only"));
+    }
+    let job = searches
+        .active
+        .lock()
+        .map_err(|_| AppError::new("internal", "Search unavailable"))?
+        .as_ref()
+        .filter(|job| job.id == job_id)
+        .cloned()
+        .ok_or_else(|| AppError::new("invalid_grant", "Search expired"))?;
+    job.check_open()?;
+    let hit = job
+        .results
+        .lock()
+        .map_err(|_| AppError::new("internal", "Search unavailable"))?
+        .get(&hit_id)
+        .cloned()
+        .ok_or_else(|| AppError::new("invalid_hit", "Search hit expired"))?;
+    let state = state.inner().clone();
+    tauri::async_runtime::spawn_blocking(move || {
+        job.check_open()?;
+        let root = state.root(&job.root_id)?;
+        if root.generation != job.generation {
+            return Err(AppError::new("invalid_grant", "Root changed"));
+        }
+        let file = job.scope.open(&root, &hit.segments, false)?;
+        let grant = state.register_root_file(&root, hit.segments, &file)?;
+        job.check_open()?;
+        let view = crate::html::open_registered(&state, grant.id)?;
+        let valid = job.check_open().and_then(|_| {
+            if state.root(&job.root_id)?.generation == job.generation {
+                Ok(())
+            } else {
+                Err(AppError::new("invalid_grant", "Root changed"))
+            }
+        });
+        if let Err(e) = valid {
+            crate::html::discard_unmounted(&view);
+            return Err(e);
+        }
+        Ok(view)
+    })
+    .await
+    .map_err(|_| AppError::new("internal", "Search opening task failed"))?
+}
