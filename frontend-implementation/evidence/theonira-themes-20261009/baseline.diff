+.native-settings .tree-preference { flex-wrap: nowrap; font-weight: 600; }
+.native-settings footer { position: static; flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 20px 36px; border-top: 1px solid var(--border); background: var(--surface); }
