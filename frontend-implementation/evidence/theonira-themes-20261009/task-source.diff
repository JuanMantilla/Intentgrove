+/* Approved Theonira studies: shared shell, exact paired palette and layout rhythm.
+   The document and editor keep their existing owners; these rules only compose them. */
+.workspace-icon { width: 18px; height: 18px; flex: 0 0 auto; vertical-align: middle; }
+button { background: var(--surface); font-weight: 500; }
+button:focus-visible, select:focus-visible, input:focus-visible { outline-width: 3px; outline-offset: 3px; }
+button:active:not(:disabled) { background: var(--selection); }
+.primary-button:active:not(:disabled) { background: var(--accent-hover); color: var(--action-text); }
+.app-header { flex: 0 0 auto; background: var(--canvas); }
+.global-header { height: 72px; display: flex; align-items: center; gap: 24px; padding: 0 24px; border-bottom: 1px solid var(--border); }
+.theonira-wordmark { display: flex; align-items: center; gap: 8px; white-space: nowrap; font-size: 18px; letter-spacing: -.02em; }
+.theonira-wordmark img { width: 32px; height: 32px; object-fit: contain; }
+.theonira-wordmark strong { font-weight: 700; }
+.product-name { font-weight: 500; color: var(--muted); }
+.global-utilities { margin-inline-start: auto; display: flex; align-items: center; gap: 8px; }
+.global-utilities .local-badge { display: flex; align-items: center; gap: 8px; margin-inline-end: 8px; }
+.utility-button { display: grid; place-items: center; min-width: 38px; min-height: 36px; padding: 8px; }
+.global-language { position: relative; }
+.global-language select { appearance: none; background: var(--surface); color: var(--text); border: 1px solid var(--control-border); border-radius: 6px; height: 36px; padding: 6px 32px 6px 12px; font: inherit; }
+.global-language .workspace-icon { width: 14px; position: absolute; right: 10px; top: 9px; pointer-events: none; }
+.workspace-toolbar { min-height: 56px; display: flex; align-items: center; gap: 8px; padding: 8px 24px; border-bottom: 1px solid var(--border); }
+.workspace-toolbar button, .document-location-actions > button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 36px; padding: 8px 12px; font-size: 14px; }
+.ghost-button { border-color: transparent; background: transparent; }
+.workspace-toolbar-actions { margin-inline-start: auto; display: flex; gap: 8px; }
+.workspace-title { font-size: 14px; font-weight: 600; }
+.workspace-layout { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: 48px minmax(0, 1fr); }
+.document-tabs { grid-column: 1 / -1; grid-row: 1; min-width: 0; height: 48px; min-height: 48px; background: var(--canvas); border-bottom: 1px solid var(--border); }
+.tab-strip { background: transparent; border: 0; min-height: 0; }
+.tab { min-width: 160px; max-width: 280px; }
+.tab > button:first-child { font-size: 14px; color: var(--muted); gap: 8px; }
+.tab.active > button:first-child { color: var(--text); font-weight: 500; }
+.tab .workspace-icon { width: 14px; height: 14px; }
+.tab-close { font-size: 18px; margin-inline: 8px; }
+.dirty-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: none; }
+.document-list-trigger { border-color: transparent; background: transparent; color: var(--muted); font-size: 12px; }
+.history-menu-trigger { border-color: transparent; background: transparent; font-size: 13px; }
+.main-panel { grid-column: 2; grid-row: 2; min-height: 0; background: var(--surface); }
+.sidebar { grid-column: 1; grid-row: 2; background: var(--canvas); padding-top: 16px; }
+.sidebar-heading { padding: 0 24px 8px; }
+.projects-trigger { min-height: 32px; padding: 0; border: 0 !important; background: transparent; font-size: 12px; letter-spacing: .06em; font-weight: 400; color: var(--muted) !important; }
+.explorer-search-launcher { display: flex; align-items: center; gap: 8px; margin: 0 12px 16px; padding: 8px 12px; min-height: 40px; color: var(--muted); text-align: start; font-size: 14px; }
+.sidebar:has(.folder-search-host:not([hidden])) .explorer-search-launcher { display: none; }
+.root-label { padding: 0 24px 12px; font-size: 14px; font-weight: 500; }
+.tree-scroll { padding-inline: 12px; }
+.tree-row { min-height: 36px; padding: 8px 12px; border-radius: 6px; font-size: 14px; }
+.tree-icon { display: inline-flex; flex-basis: 16px; }
+.tree-icon .workspace-icon { width: 16px; height: 16px; }
+.tree-row[aria-current="page"], .tree-row.selected { color: var(--accent); background: var(--hover); font-weight: 500; }
+.sidebar-footnote { margin-top: auto; padding: 16px 24px; font-size: 12px; line-height: 1.6; }
+.sidebar-footnote strong { font-weight: 400; }
+.sidebar-footnote > button { font-size: 12px; margin-top: 8px; }
