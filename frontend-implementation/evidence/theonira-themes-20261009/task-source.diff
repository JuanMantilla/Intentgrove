+.markdown-body { --prose-measure: var(--reading-width, 760px); }
+.markdown-body h1 { font-size: 36px; line-height: 1.15; letter-spacing: -.035em; font-weight: 600; margin: 0 0 24px; }
+.markdown-body h2 { font-size: 24px; line-height: 1.3; letter-spacing: -.02em; font-weight: 500; margin: 32px 0 12px; border: 0; padding: 0; }
+.markdown-body p, .markdown-body li { margin-top: 0; margin-bottom: 16px; }
+.section-heading { position: relative; }
+.section-edit-button { opacity: 0; font-size: 12px; min-height: 32px; padding: 6px 10px; position: absolute; inset-inline-end: 0; top: 0; background: var(--surface); }
+.section-heading:hover .section-edit-button, .section-heading:focus-within .section-edit-button { opacity: 1; }
+@media (hover: none) { .section-edit-button { opacity: 1; position: static; } }
