+def tick_when_available(config, call_ai=runner.ai_pass):
+    """Keep execution exclusive, but let restoration acquire the lock while idle."""
+    with contextlib.ExitStack() as stack:
+        try:
+            stack.enter_context(runner.lock('worker'))
+        except BlockingIOError:
+            return False  # Another guarded operation owns the worker lock.
+        tick(config, call_ai)
+        return True
