+fn lifecycle_anchor(name: &str, anchor: ReadingAnchor) -> ReadingAnchor {
+    if crate::scope::prototype_name(name) {
+        ReadingAnchor {
+            heading_id: None,
+            offset: 0.,
+            scroll_top: 0.,
+            viewport_width: 0.,
+            viewport_height: 0.,
+            content_version: None,
+            html_zoom: None,
+            html_scroll_left: None,
+        }
+    } else {
+        anchor
+    }
+}
