{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Intentgrove Blob Guard Probe 20261008",
  "version": "0.1.0",
  "identifier": "com.juanmantilla.intentgrove.blobguardprobe20261008",
  "build": {
    "frontendDist": "/Users/juanmantilla/projects/personal/md-reader/qa/runs/macos-completion-20261008/probe",
    "beforeBuildCommand": ""
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src blob:"
    },
    "windows": [
      {
        "title": "Intentgrove",
        "create": false,
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}